GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_PROPOSAL_BUCKET=proposal-formats
COHERE_KEY=your_cohere_key
QDRANT_URL=your_qdrant_url
QDRANT_KEY=your_qdrant_key

# Retrieval tuning
RETRIEVAL_TOP_K=7
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_MAX_CONTEXT_WORDS=1800
RETRIEVAL_MAX_CONTEXT_CHUNKS=8
RETRIEVAL_TENDER_MAX_CHUNKS=5
RETRIEVAL_COMPANY_MAX_CHUNKS=4
RETRIEVAL_ENABLE_NEIGHBORS=false
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_DEBUG=false

# Proposal generation style: concise | standard | detailed
PROPOSAL_RESPONSE_VERBOSITY=concise
